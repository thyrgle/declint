Output editor.gif
Set FontSize 16
Set Width 880
Set Height 480
Set Padding 12
Set CursorBlink false
Set Theme {
  "name": "Whimsical",
  "background": "#16161e",
  "foreground": "#c0caf5",
  "black": "#16161e",
  "red": "#f7768e",
  "green": "#9ece6a",
  "yellow": "#e0af68",
  "blue": "#7aa2f7",
  "magenta": "#bb9af7",
  "cyan": "#7dcfff",
  "white": "#c0caf5",
  "brightBlack": "#565f89",
  "brightRed": "#f7768e",
  "brightGreen": "#9ece6a",
  "brightYellow": "#e0af68",
  "brightBlue": "#7aa2f7",
  "brightMagenta": "#bb9af7",
  "brightCyan": "#7dcfff",
  "brightWhite": "#c0caf5"
}

# Requires: the declint.nvim checkout as a sibling of the declint repo
# (../../declint.nvim), and `declint` on PATH.
Type "nvim -u ../../declint.nvim/scripts/minimal-init.lua app.py"
Enter
Sleep 1s
Sleep 2s
Sleep 3s
Sleep 4s
Sleep 4s
