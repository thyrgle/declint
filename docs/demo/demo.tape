Output demo.gif
Set FontSize 16
Set Width 880
Set Height 480
Set Padding 28
Set CursorBlink false
Set Theme {
  "name": "Whimsical",
  "background": "#16161e",
  "foreground": "#c0caf5",
  "black": "#16161e",
  "red": "#f7768e",
  "green": "#9ece6a",
  "yellow": "#e0af68",
  "blue": "#7aa2f7",
  "magenta": "#bb9af7",
  "cyan": "#7dcfff",
  "white": "#c0caf5",
  "brightBlack": "#565f89",
  "brightRed": "#f7768e",
  "brightGreen": "#9ece6a",
  "brightYellow": "#e0af68",
  "brightBlue": "#7aa2f7",
  "brightMagenta": "#bb9af7",
  "brightCyan": "#7dcfff",
  "brightWhite": "#c0caf5"
}
Set Shell bash
Set TypingSpeed 40ms

Type "declint check ."
Enter
Sleep 2500ms
Sleep 1500ms

Type "declint check --fix ."
Enter
Sleep 2000ms
Sleep 1200ms

Type "declint test"
Enter
Sleep 2500ms
Sleep 1200ms

Type "declint init --lang python"
Enter
Sleep 1800ms
Sleep 800ms
